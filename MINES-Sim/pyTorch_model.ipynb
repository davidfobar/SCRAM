    "#train the model\n",
    "\n",
    "nEpochs = 100\n",
    "\n",
    "for epoch in range(nEpochs):\n",
    "    running_loss = 0.0\n",
    "    for i, data in enumerate(dataLoader, 0):\n",
    "        # get the inputs; data is a list of [inputs, labels]\n",
    "        inputs, labels = data\n",
    "        inputs, labels = inputs.to(device), labels.to(device)\n",
    "\n",
    "        # zero the parameter gradients\n",
    "        optimizer.zero_grad()\n",
    "\n",
    "        # forward + backward + optimize\n",
    "        gruOutput = gru(inputs)\n",
    "        decoderInput = torch.cat((gruOutput, torch.zeros(batchSize, nTimesteps, weatherOutputSize+terrainOutputSize).to(device)), 2)\n",
    "        outputs = decoder(decoderInput)\n",
    "        loss = criterion(outputs, labels)\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "\n",
    "        # print statistics\n",
    "        running_loss += loss.item()\n",
    "        if i % 10 == 9:    # print every 10 mini-batchesS\n",
    "            print('[%d, %5d] loss: %.3f' %\n",
    "                  (epoch + 1, i + 1, running_loss / 10))\n",
    "            running_loss = 0.0"
   ]
