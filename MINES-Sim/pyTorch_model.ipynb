    "## define a GRU model for the ingest of sensor data\n",
    "\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "from torchinfo import summary\n",
    "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "\n",
    "# the sensor data will be in the form [batch_size, nTimesteps, nDetectors, nFeatures]\n",
    "# the results of the GRU will be in the form [batch_size, nTimesteps, output_size]\n",
    "# eventually, the output of the GRU will be combined with weather and terrain data\n",
    "# to reconstruct the dose rate map\n",
    "\n",
    "class GRU(nn.Module):\n",
    "    def __init__(self, input_size, hidden_size, hiddenLayers, dropout):\n",
    "        super(GRU, self).__init__()\n",
    "        self.hidden_size = hidden_size\n",
    "        self.hiddenLayers = hiddenLayers\n",
    "\n",
    "        self.gru = nn.GRU(input_size, hidden_size, hiddenLayers, dropout=dropout, batch_first=True)\n",
    "\n",
    "    def forward(self, x):\n",
    "        x = x.view(x.size(0), x.size(1), -1)\n",
    "        out, _ = self.gru(x)\n",
    "\n",
    "        return out\n",
    "    \n",
    "#initialize the model\n",
    "nDetectors = detData.shape[2]\n",
    "nTimesteps = detData.shape[1]\n",
    "input_size = nDetectors*5\n",
    "hidden_size = 32\n",
    "hiddenLayers = 2\n",
    "\n",
    "#initialize the model\n",
    "gru = GRU(input_size, hidden_size, hiddenLayers=hiddenLayers, dropout=0.1).to(device)\n",
    "\n",
    "#test the model\n",
    "summary(gru, input_size=(batchSize, nTimesteps, nDetectors*5))\n"
   ]
