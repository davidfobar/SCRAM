    "## define a decoder model the uses the dose, weather, and terrain models to reconstruct the dose rate map\n",
    "# the input will be in the form [batch_size, nTimesteps, gru output size + weather output size+ terrain output size]\n",
    "# the output will be in the form [batch_size, nTimesteps, mapSize, mapSize]\n",
    "\n",
    "doseOutputSize = 32\n",
    "weatherOutputSize = 16\n",
    "terrainOutputSize = 16\n",
    "decoderHiddenSize = 64\n",
    "nTimesteps = 100\n",
    "\n",
    "doseMapInputSize = doseOutputSize + weatherOutputSize + terrainOutputSize\n",
    "mapSize = 256\n",
    "    \n",
    "#redefine the decoder\n",
    "class Decoder(nn.Module):\n",
    "    def __init__(self, input_size, output_size):\n",
    "        super(Decoder, self).__init__()\n",
    "        self.hidden_size = hidden_size\n",
    "        self.output_size = output_size\n",
    "\n",
    "        self.gru = nn.GRU(input_size, input_size)\n",
    "        self.deconv1 = nn.ConvTranspose2d(in_channels=1, out_channels=32, kernel_size=3, stride=2, padding=4, dilation=2) # 32x11x11\n",
    "        self.deconv2 = nn.Conv2d(in_channels=32, out_channels=8, kernel_size=3, stride=1, padding=1) # 8x11x11\n",
    "        self.fc = nn.Linear(8*11*11, output_size)\n",
    "\n",
    "    def forward(self, x):\n",
    "        x, _ = self.gru(x)\n",
    "        x = x.view(-1, nTimesteps, 8, 8)\n",
    "        \n",
    "        #apply the deconvolutional layers to each timestep\n",
    "        reconstructedMaps = []\n",
    "        for i in range(nTimesteps):\n",
    "            out = x[:,i,:,:].unsqueeze(1)\n",
    "            out = F.relu(self.deconv1(out))\n",
    "            out = F.relu(self.deconv2(out))\n",
    "            out = out.view(-1, 8*11*11)\n",
    "            out = self.fc(out)\n",
    "            reconstructedMaps.append(out)\n",
    "\n",
    "        reconstructedMaps = torch.stack(reconstructedMaps, dim=1)\n",
    "        reconstructedMaps = reconstructedMaps.view(-1, nTimesteps, mapSize, mapSize)\n",
    "        return reconstructedMaps\n",
    "\n",
    "#initialize the model\n",
    "decoder = Decoder(doseMapInputSize, mapSize*mapSize).to(device)\n",
    "\n",
    "#test the model\n",
    "summary(decoder, input_size=(batchSize, nTimesteps, doseMapInputSize))\n"
   ]
  },
