    "## for a single simulation, plot the mse of the dose rate map predictions as a function of time\n",
    "\n",
    "fig, ax = plt.subplots(1, 1, figsize=(12, 6))\n",
    "mse = np.zeros(timesteps)\n",
    "for t in range(timesteps):\n",
    "    mse[t] = np.mean((outputs[0, t, :, :].detach().cpu().numpy() - labels[0, t, :, :].detach().cpu().numpy())**2)\n",
    "ax.plot(mse)\n",
    "ax.set_xlabel('Time')\n",
    "ax.set_ylabel('MSE')\n",
    "ax.set_title('MSE of Dose Rate Map Predictions')\n",
    "plt.show()"
